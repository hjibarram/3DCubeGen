#!/usr/bin/env python3

import click
import cloup
from cloup.constraints import mutually_exclusive, RequireExactly, IsSet, If
import numpy as np
import os
import CubeGen
from CubeGen.virustools.vpcubegen import virusmap_ifu
#import CubeGen.megaratools.megtools as mtools
#import CubeGen.megaratools.megcubegen as mcube
#import CubeGen.megaratools.megmapgen as mmap
import CubeGen.tools.tools as tools
import warnings
warnings.filterwarnings("ignore")

@click.group('vpcubetools', short_help='CLI for the MEGARA DRP tools')
def cli():
    pass


@cloup.command(short_help='Run the virusP cube tools')
@click.option('-c', '--config_file', type=str, default='', help='name of the config file')
@click.option('-i', '--name_list', type=list, help='list of input observation pointings')
@click.option('-o', '--out_path', type=str, default='out_cubes/', help='path of the output cube files')
#@click.option('-v', '--redux_ver', type=str, default='1.1.1.dev0', help='the DRP reduction version of the lvmCFrame')
@click.option('-r', '--redux_dir', type=str, default='', help='path of the redux RSS dir')
@click.option('-s', '--sigm_s', type=float, default=32.2, help='smoth kernel size used to reconstruct the cube')
@click.option('-p', '--pix_s', type=float, default=0.0, help='spaxel size used to reconstruct the cube, default set to 0 to fix it to 0.75*sigm_s')
@click.option('-a', '--alph_s', type=float, default=2.0, help='kernel "shape" factor, a value equal of 2 returns a Gaussian kerner, larger than 2 returns a sharper kernel')
@click.option('-f', '--flu16', is_flag=True, default=True,help='keyword to return a cube with units of 10^{-16} erg/s/cm2/A, if False, the units are erg/s/cm2/A')
@click.option('-n', '--namef', type=str, help='output root name of the data cube')
@click.option('-m', '--fibA', type=float, default=4.16,help='Fiber diameter of VirusP, default value 4.16 arcsec')
#@click.option('-b', '--pbars', is_flag=True, default=True,help='activate or deactivate the progress bar')
@click.option('-g', '--spec_range', type=tuple, default=(None,None), help='optional, spectral range for the output cube')
@click.option('-t', '--base_nameWCS', type=str, default='NAME_wcs.txt', help='base name of the WCS file')
@click.option('-y', '--basename', type=str, default='NAME_abscal_HST.fits', help='base name of the RSS file')
@click.option('-h', '--basenameC', type=str, default='vpCube-NAME.fits', help='base name of the final output cube file')
@click.option('-e', '--errors', is_flag=True, default=True,help='activate or deactivate the error estimation')
@click.option('-u', '--fac_sizey', type=float, default=1.1, help='factor of the FoV in Y')
@click.option('-i', '--fac_sizex', type=float, default=1.1, help='factor of the FoV in X')
@click.option('-k', '--radvel', is_flag=True, default=True,help='activate the heliocentric correction')

def vpcube(config_file,name_list,out_path,redux_dir,sigm_s,pix_s,alph_s,flu16,namef,fibA,spec_range,base_nameWCS,basename,basenameC,errors,fac_sizey,fac_sizex,radvel,coord_cen):

    data=tools.read_config_file(config_file)
    if data:
        typeF=data['vpcube'][0]['survey_type']
        if 'virusP' in typeF:
            name_list=data['vpcube'][0]['name_list']
            out_path=data['vpcube'][0]['out_path']
            #redux_ver=data['vpcube'][0]['redux_ver']
            redux_dir=data['vpcube'][0]['redux_dir']
            sigm_s=data['vpcube'][0]['sigm_s']
            pix_s=data['vpcube'][0]['pix_s']
            alph_s=data['vpcube'][0]['alph_s']
            flu16=data['vpcube'][0]['flu16']
            namef=data['vpcube'][0]['nameF']
            fibA=data['vpcube'][0]['fibA']
            #pbars=data['vpcube'][0]['pbars']
            spec_range=data['vpcube'][0]['spec_range']
            base_nameWCS=data['vpcube'][0]['base_nameWCS']
            basename=data['vpcube'][0]['basename']
            basenameC=data['vpcube'][0]['basenameC']
            errors=data['vpcube'][0]['errors']
            fac_sizey=data['vpcube'][0]['fac_sizeY']
            fac_sizex=data['vpcube'][0]['fac_sizeX']
            radvel=data['vpcube'][0]['radvel']
            if spec_range[0] == 0 and spec_range[1] == 0:
                spec_range=(None,None)
            else:
                spec_range=(spec_range[0],spec_range[1])
        else:
            print('Error: The config file is not for VirusP data')
            return
    

    if pix_s == 0:
        pix_s=0.75*sigm_s
    headerInfo={}
    #notebook=False

    virusmap_ifu(name_list,nameF=namef,radvel=radvel,dlt=0,hdrs=0,hdre=1,errors=errors,flu16=flu16,
        spec_range=spec_range,headerInfo=headerInfo,fac_sizeX=fac_sizex,fac_sizeY=fac_sizey,
        fibA=fibA,pix_s=pix_s,sigm_s=sigm_s,alph_s=alph_s,out_path=out_path,redux_dir=redux_dir,
        basename=basename,base_nameWCS=base_nameWCS,basenameC=basenameC)
    
cli.add_command(vpcube)

if __name__ == "__main__":
    cli()